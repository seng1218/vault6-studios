// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artifact {
  id           String     @id @default(uuid())
  deploymentId String     @unique
  name         String
  series       String
  category     String
  price        String
  status       String
  scale        String
  material     String
  highlights   String     @default("")
  imageUrls    String     @default("")
  condition    String     @default("MISB")
  manufacturer String     @default("Unknown")
  inventory    Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wishlist     Wishlist[]
}

model SiteSetting {
  key   String @id
  value String
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  phone        String     @default("")
  address      String     @default("")
  city         String     @default("")
  state        String     @default("")
  zip          String     @default("")
  country      String     @default("MALAYSIA")
  isPublicProfile Boolean    @default(false)
  operativeName   String?
  createdAt    DateTime   @default(now())
  orders       Order[]
  wishlist     Wishlist[]
}

model Wishlist {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, artifactId])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  phone           String      @default("")
  address         String
  city            String
  state           String
  zip             String
  country         String      @default("MALAYSIA")
  subtotal        Float
  shipping        Float
  total           Float
  status          String      @default("PENDING")
  transactionId   String?
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  artifactId   String
  artifactName String
  price        Float
  quantity     Int
}
