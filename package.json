{
  "name": "figurine-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "cf:build": "npx rimraf .open-next && npx opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && npx wrangler dev",
    "cf:deploy": "npm run cf:build && node patch-prisma-wasm.js && npx wrangler deploy",
    "d1:setup": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output migration.sql",
    "d1:migrate:remote": "wrangler d1 execute vault6-studios-db --remote --file=migration.sql",
    "d1:migrate:local": "wrangler d1 execute vault6-studios-db --local --file=migration.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.14.1",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "wrangler": "^4.93.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
